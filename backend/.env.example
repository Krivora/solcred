# Copia este archivo a .env y rellena los valores. `src/config/env.ts` valida
# esto al arrancar: si falta algo obligatorio o tiene mal formato, el proceso
# muere nombrando la variable.

# ── Obligatorias ────────────────────────────────────────────
# Cadena de conexión de PostgreSQL (postgres:// o postgresql://).
DATABASE_URL=postgresql://usuario:password@host:5432/basededatos

# Secreto para firmar los access tokens JWT. Usa una cadena larga y aleatoria
# (>=32 caracteres en producción).
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# ── Opcionales (tienen valor por defecto) ───────────────────
NODE_ENV=development
PORT=4000

# URL del frontend, para CORS. Default: http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Saltos de proxy en los que confiar para X-Forwarded-For (rate-limit / IP de
# auditoría). Nunca "true". 0 = sin proxy delante. Default: 1
TRUST_PROXY=1

# "true" solo en producción con https (hace Secure la cookie del refresh token).
# Default: false
COOKIE_SECURE=false

# Vida del access token (formato de `jsonwebtoken`, ej. "15m"). Default: 15m
JWT_ACCESS_EXPIRES_IN=15m

# Ventana deslizante del refresh token, en días, por perfil de riesgo.
# Defaults: cliente 30, staff operativo 7, staff sensible 2.
REFRESH_TTL_DIAS_CLIENTE=30
REFRESH_TTL_DIAS=7
REFRESH_TTL_DIAS_SENSIBLE=2
