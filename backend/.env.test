# Entorno de las pruebas de integración. Apunta al Postgres de docker-compose.test.yml.
# Puerto 55432 para no chocar con un Postgres local en 5432.
DATABASE_URL="postgresql://solcred:solcred@localhost:55432/solcred_test?schema=public"
JWT_SECRET="test-secret-no-usar-en-produccion"
JWT_ACCESS_EXPIRES_IN="15m"
REFRESH_TTL_DIAS="7"
COOKIE_SECURE="false"
FRONTEND_URL="http://localhost:3000"
NODE_ENV="test"
