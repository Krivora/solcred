generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────
enum TipoUsuario {
  CLIENTE
  PERSONAL
}

enum Rol {
  ADMIN
  ANALISTA
  GESTOR
  SUPERVISOR
}

enum TipoPersona {
  FISICA
  MORAL
}

enum TipoPersonaDocumento {
  FISICA
  MORAL
  AMBOS
}

enum EstatusSolicitud {
  BORRADOR
  PENDIENTE
  EN_REVISION
  EN_CORRECCION
  EN_FINANCIAMIENTO // financiamiento: Mesa de Control
  EN_APROBACION
  EN_ASIGNACION // financiamiento: cola de asignación de analista
  EN_ANALISIS // financiamiento: analista trabajando el caso
  EN_VALIDACION // financiamiento: análisis en validación
  EN_COMITE // financiamiento: comité de crédito
  APROBADO
  RECHAZADO
  CANCELADO
}

enum EstadoCivil {
  SOLTERO
  CASADO
  DIVORCIADO
  VIUDO
  UNION_LIBRE
}

enum NivelEstudio {
  PRIMARIA
  SECUNDARIA
  PREPARATORIA
  TECNICO
  LICENCIATURA
  MAESTRIA
  DOCTORADO
}

enum TamanoEmpresa {
  MICRO
  PEQUENA
  MEDIANA
  GRANDE
}

enum Sector {
  AGROPECUARIO
  INDUSTRIAL
  COMERCIAL
  SERVICIOS
  TECNOLOGIA
  OTRO
}

enum Requerimiento {
  NO_REQUIERE
  OPCIONAL
  OBLIGATORIO
}

enum TipoVivienda {
  PROPIA
  RENTADA
  PAGANDO
}

enum OperadorRegla {
  IGUAL
  DIFERENTE
  EN_LISTA // valor es JSON array: ["FISICA","MORAL"]
  MAYOR_QUE
  MENOR_QUE
  MAYOR_IGUAL
  MENOR_IGUAL
}

enum CampoRegla {
  TIPO_PERSONA
  SECTOR
  TAMANO_EMPRESA
  PROGRAMA_ID
  MONTO_SOLICITADO
}

enum EstatusDocumento {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum CategoriaCredito {
  CAPITAL
  MAQUINARIA_EQUIPO
  REMODELACION
}

enum TipoGarantia {
  PRENDARIA
  HIPOTECARIA
}

enum TipoLocal {
  PROPIO
  RENTADO
  FAMILIAR
  OTRO
}

enum SeccionSolicitud {
  SOLICITANTE
  AVAL
  CREDITO
  GARANTIA
  NEGOCIO
  MERCADO
  BANCARIOS
}

model HistorialEstatus {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String

  estatusAnterior EstatusSolicitud
  estatusNuevo    EstatusSolicitud
  motivo          String?

  usuario   Usuario @relation(fields: [usuarioId], references: [id])
  usuarioId String

  creadoEn DateTime @default(now())

  @@index([solicitudId])
}

model GrupoGestion {
  id          String  @id @default(uuid())
  nombre      String
  descripcion String?
  activo      Boolean @default(true)
  prioridad   Int     @default(0) // mayor número = mayor prioridad al evaluar

  reglas       ReglaGrupo[]
  gestores     GrupoGestor[]
  asignaciones AsignacionSolicitud[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model ReglaGrupo {
  id      String       @id @default(uuid())
  grupo   GrupoGestion @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  grupoId String

  campo    CampoRegla
  operador OperadorRegla
  valor    String // siempre string, el motor lo castea según el campo

  creadoEn DateTime @default(now())
}

model GrupoGestor {
  grupo    GrupoGestion @relation(fields: [grupoId], references: [id], onDelete: Cascade)
  grupoId  String
  gestor   Personal     @relation(fields: [gestorId], references: [id])
  gestorId String
  activo   Boolean      @default(true)

  asignadoEn DateTime @default(now())

  @@id([grupoId, gestorId])
}

model AsignacionSolicitud {
  id          String       @id @default(uuid())
  solicitud   Solicitud    @relation(fields: [solicitudId], references: [id])
  solicitudId String
  gestor      Personal     @relation("AsignacionesComoGestor", fields: [gestorId], references: [id])
  gestorId    String
  grupo       GrupoGestion @relation(fields: [grupoId], references: [id])
  grupoId     String

  asignadoPor   Personal? @relation("AsignacionesComoSupervisor", fields: [asignadoPorId], references: [id])
  asignadoPorId String?

  activa             Boolean   @default(true)
  fechaAsignacion    DateTime  @default(now())
  fechaReasignacion  DateTime?
  motivoReasignacion String?

  @@index([gestorId])
  @@index([grupoId])
  @@index([solicitudId])
}

// Asignación de una solicitud a un analista dentro del área de Financiamiento.
// Espejo ligero de AsignacionSolicitud, sin grupo: Financiamiento no usa el
// motor de reglas (GrupoGestion / ReglaGrupo), la asignación es manual.
model AsignacionFinanciamiento {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String

  analista   Personal @relation("FinanciamientoComoAnalista", fields: [analistaId], references: [id])
  analistaId String

  asignadoPor   Personal? @relation("FinanciamientoAsignadoPor", fields: [asignadoPorId], references: [id])
  asignadoPorId String?

  // Invariante: como máximo una fila `activa` por `solicitudId`. Prisma no
  // expresa índices únicos parciales; se garantiza en `asignarAnalistas`
  // serializando con `SELECT ... FOR UPDATE` sobre la Solicitud.
  activa             Boolean   @default(true)
  fechaAsignacion    DateTime  @default(now())
  fechaReasignacion  DateTime?
  motivoReasignacion String?

  @@index([analistaId])
  @@index([solicitudId])
}

// ─────────────────────────────────────────
// USUARIOS DEL SISTEMA
// ─────────────────────────────────────────

model Usuario {
  id          String      @id @default(uuid())
  correo      String      @unique
  contrasena  String
  tipoUsuario TipoUsuario @default(CLIENTE)
  tipoPersona TipoPersona

  nombre          String
  apellidoPaterno String
  apellidoMaterno String
  curp            String? @unique
  rfc             String? @unique

  activo        Boolean  @default(true)
  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  solicitudes      Solicitud[]
  logs             LogAuditoria[]
  historialEstatus HistorialEstatus[]

  personal Personal?
}

model Personal {
  id      String  @id @default(uuid())
  usuario Usuario @relation(fields: [userId], references: [id])
  userId  String  @unique

  rol          Rol
  departamento String?
  extension    String?

  supervisor   Personal?  @relation("Jerarquia", fields: [supervisorId], references: [id])
  supervisorId String?
  subordinados Personal[] @relation("Jerarquia")

  fechaIngreso DateTime @default(now())
  activo       Boolean  @default(true)

  gruposGestion       GrupoGestor[]
  asignacionesGestor  AsignacionSolicitud[] @relation("AsignacionesComoGestor")
  asignacionesDadas   AsignacionSolicitud[] @relation("AsignacionesComoSupervisor")
  documentosValidados DocumentoSolicitud[]  @relation("DocumentosValidados")

  asignacionesFinanciamiento AsignacionFinanciamiento[] @relation("FinanciamientoComoAnalista")
  financiamientoAsignadoPor  AsignacionFinanciamiento[] @relation("FinanciamientoAsignadoPor")
  analisis                   Analisis[]                 @relation("AnalisisComoAnalista")

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([rol])
  @@index([departamento])
}

// ─────────────────────────────────────────
// PROGRAMAS DE CRÉDITO
// ─────────────────────────────────────────

model Programa {
  id          String @id @default(uuid())
  nombre      String
  descripcion String
  objetivo    String

  permitePersonaFisica Boolean @default(true)
  permitePersonaMoral  Boolean @default(true)

  montoMinimo Float
  montoMaximo Float

  tasaOrdinaria Float
  tasaMoratoria Float
  tasaAnual     Float

  plazoMinimoMeses Int
  plazoMaximoMeses Int

  datosFinancierosCompletos Boolean  @default(false)
  activo                    Boolean  @default(true)
  creadoEn                  DateTime @default(now())
  actualizadoEn             DateTime @updatedAt

  documentosRequeridos ProgramaDocumento[]
  secciones            ProgramaSeccion[]
  solicitudes          Solicitud[]
}

model ProgramaSeccion {
  id            String           @id @default(uuid())
  programa      Programa         @relation(fields: [programaId], references: [id], onDelete: Cascade)
  programaId    String
  seccion       SeccionSolicitud
  requerimiento Requerimiento    @default(NO_REQUIERE)

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@unique([programaId, seccion])
  @@index([programaId])
}

// ─────────────────────────────────────────
// TIPOS DE DOCUMENTO
// ─────────────────────────────────────────

model TipoDocumento {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  creadoEn    DateTime @default(now())

  programas  ProgramaDocumento[]
  documentos DocumentoSolicitud[]
}

model ProgramaDocumento {
  id              String                @id @default(uuid())
  programa        Programa              @relation(fields: [programaId], references: [id])
  programaId      String
  tipoDocumento   TipoDocumento         @relation(fields: [tipoDocumentoId], references: [id])
  tipoDocumentoId String
  esObligatorio   Boolean               @default(true)
  aplicaA         TipoPersonaDocumento? // null = aplica a ambos tipos de persona

  @@unique([programaId, tipoDocumentoId])
}

// ─────────────────────────────────────────
// SOLICITUDES DE CRÉDITO
// ─────────────────────────────────────────

model Solicitud {
  id    String @id @default(uuid())
  folio String @unique // ← nuevo

  programa      Programa @relation(fields: [programaId], references: [id])
  programaId    String
  solicitante   Usuario  @relation(fields: [solicitanteId], references: [id])
  solicitanteId String

  estatus       EstatusSolicitud @default(BORRADOR)
  tipoPersona   TipoPersona?
  sector        Sector?
  tamanoEmpresa TamanoEmpresa?

  datosSolicitante           DatosSolicitante?
  datosAval                  DatosAval?
  datosCredito               DatosCredito?
  datosGarantia              DatosGarantia?
  datosNegocio               DatosNegocio?
  datosMercado               DatosMercado?
  datosBancarios             DatosBancarios?
  documentos                 DocumentoSolicitud[]
  historialEstatus           HistorialEstatus[]
  asignaciones               AsignacionSolicitud[]
  asignacionesFinanciamiento AsignacionFinanciamiento[]
  analisis                   Analisis?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

// Análisis financiero del analista (segundo filtro). Un análisis por solicitud.
// Cada pestaña de la herramienta se guarda como JSON — el frontend es la fuente
// de verdad del esquema interno; los cálculos (totales, KPIs) se hacen en cliente.
model Analisis {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String    @unique
  analista    Personal  @relation("AnalisisComoAnalista", fields: [analistaId], references: [id])
  analistaId  String

  situacionFinanciera Json?
  ajustesCredito      Json?
  criteriosEvaluacion Json?
  amortizacion        Json?
  comentario          String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([analistaId])
}

// ─────────────────────────────────────────
// DATOS GENERALES DEL SOLICITANTE
// ─────────────────────────────────────────
model DatosSolicitante {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String    @unique

  nombre          String
  apellidoPaterno String
  apellidoMaterno String
  curp            String?
  rfc             String?

  telefono String?
  celular  String?
  correo   String?

  calle          String?
  numeroExterior String?
  numeroInterior String?
  colonia        String?
  ciudad         String?
  estado         String?
  codigoPostal   String?

  nivelEstudio NivelEstudio?
  universidad  String?
  estadoCivil  EstadoCivil?

  nombreConyuge String?
  numeroINE     String?

  tipoVivienda TipoVivienda?

  aniosDomicilioActual   Int?
  aniosDomicilioAnterior Int?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model DatosAval {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String    @unique

  nombre          String
  apellidoPaterno String
  apellidoMaterno String
  curp            String?
  rfc             String?

  telefono String?
  celular  String?
  correo   String?

  calle          String?
  numeroExterior String?
  numeroInterior String?
  colonia        String?
  ciudad         String?
  estado         String?
  codigoPostal   String?

  nivelEstudio NivelEstudio?
  universidad  String?
  estadoCivil  EstadoCivil?

  nombreConyuge String?
  numeroINE     String?

  tipoVivienda TipoVivienda?

  aniosDomicilioActual   Int?
  aniosDomicilioAnterior Int?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model DatosCredito {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String    @unique

  plazoMeses  Int
  mesesGracia Int @default(0)

  conceptos ConceptoCredito[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model ConceptoCredito {
  id             String       @id @default(uuid())
  datosCredito   DatosCredito @relation(fields: [datosCreditoId], references: [id], onDelete: Cascade)
  datosCreditoId String

  categoria CategoriaCredito
  concepto  String // el "para qué" (ej. "Compra de torno CNC")
  monto     Float

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([datosCreditoId])
  @@index([datosCreditoId, categoria])
}

model DatosGarantia {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String    @unique

  garantias Garantia[]

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model Garantia {
  id              String        @id @default(uuid())
  datosGarantia   DatosGarantia @relation(fields: [datosGarantiaId], references: [id], onDelete: Cascade)
  datosGarantiaId String

  tipo TipoGarantia

  // Comunes a ambos tipos
  nombrePropietario String
  valor             Float
  descripcion       String? // texto libre: qué es, estado, etc.

  // ── Solo PRENDARIA (bien mueble: vehículo, maquinaria, equipo) ──
  marca       String?
  modelo      String?
  anio        Int?
  numeroSerie String? // VIN / número de serie / factura

  // ── Solo HIPOTECARIA (inmueble) ──
  calle           String?
  numeroExterior  String?
  numeroInterior  String?
  colonia         String?
  ciudad          String?
  estado          String?
  codigoPostal    String?
  numeroEscritura String?
  folioReal       String? // folio real / registro público de la propiedad

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt

  @@index([datosGarantiaId])
  @@index([datosGarantiaId, tipo])
}

model DatosNegocio {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String    @unique

  razonSocial   String?
  rfcNegocio    String?
  nombreNegocio String?

  // Domicilio del negocio
  domicilioNegocio      String?
  numeroExteriorNegocio String?
  numeroInteriorNegocio String?
  coloniaLocal          String?
  codigoPostalLocal     String?
  municipioLocal        String?
  estadoLocal           String?

  actividadNegocio String?
  areaNegocio      String?

  empleosConservados Int?
  empleosNuevos      Int?

  fechaInicioOperaciones DateTime?
  antiguedadNegocio      Int?

  tipoLocal TipoLocal?

  experienciaActividadSolicitante  Int?
  experienciaEmpresarioSolicitante Int?

  actualExporta     Boolean?
  obtuvoExperiencia Boolean?
  negocioConsidera  String?

  telefonoRecadosNegocio String?
  telefonoFijoNegocio    String?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model DatosMercado {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String    @unique

  principalesProductos String? // texto libre: qué vende/produce

  // Distribución por tipo de cliente (% que debe sumar 100)
  porcentajeMayoristas   Float?
  porcentajeDetallistas  Float?
  porcentajeClienteFinal Float?

  // Cobertura geográfica (% que debe sumar 100)
  coberturaLocal       Float?
  coberturaRegional    Float?
  coberturaEstatal     Float?
  coberturaNacional    Float?
  coberturaExportacion Float?

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model DatosBancarios {
  id          String    @id @default(uuid())
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
  solicitudId String    @unique

  banco        String
  numeroCuenta String?
  clabe        String

  creadoEn      DateTime @default(now())
  actualizadoEn DateTime @updatedAt
}

model DocumentoSolicitud {
  id              String        @id @default(uuid())
  solicitud       Solicitud     @relation(fields: [solicitudId], references: [id])
  solicitudId     String
  tipoDocumento   TipoDocumento @relation(fields: [tipoDocumentoId], references: [id])
  tipoDocumentoId String
  urlArchivo      String
  nombreArchivo   String

  version         Int              @default(1)
  activo          Boolean          @default(true)
  estatus         EstatusDocumento @default(PENDIENTE)
  validadoPor     Personal?        @relation("DocumentosValidados", fields: [validadoPorId], references: [id])
  validadoPorId   String?
  fechaValidacion DateTime?
  motivoRechazo   String?
  subidoEn        DateTime         @default(now())

  @@unique([solicitudId, tipoDocumentoId, version])
  @@index([solicitudId, tipoDocumentoId])
}

enum AccionLog {
  CREAR
  ACTUALIZAR
  ELIMINAR
  CONSULTAR
  LOGIN
  LOGOUT
  ERROR
}

enum ModuloLog {
  AUTH
  USUARIOS
  PROGRAMAS
  SOLICITUDES
  DOCUMENTOS
}

model LogAuditoria {
  id          String    @id @default(uuid())
  accion      AccionLog
  modulo      ModuloLog
  descripcion String
  entidadId   String? // ID del recurso afectado
  usuarioId   String? // null si aún no está autenticado (ej: login fallido)
  ip          String?
  userAgent   String?
  metadata    Json? // datos extra si se necesitan
  creadoEn    DateTime  @default(now())
  usuario     Usuario?  @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
}
